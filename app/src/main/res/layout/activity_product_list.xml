<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainProductScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC"
    tools:context=".ProductActivity">

    <!-- ============================================================== -->
    <!-- 1. LinearLayout (Tổng): Bao bọc toàn bộ trang theo chiều dọc     -->
    <!-- ============================================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================== -->
        <!-- 2. RelativeLayout (Thanh tìm kiếm / Header):                   -->
        <!--    Icon giỏ hàng neo góc phải, ô tìm kiếm chiếm phần còn lại   -->
        <!-- ============================================================== -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <!-- Icon giỏ hàng: Neo góc phải (alignParentEnd) -->
            <ImageButton
                android:id="@+id/btnCart"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="#FFFFFF"
                android:elevation="1dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@color/text_primary"
                android:contentDescription="Giỏ hàng" />

            <!-- Ô tìm kiếm: Chiếm toàn bộ phần còn lại bên trái (toStartOf) -->
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnCart"
                android:background="@color/white"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:elevation="1dp"
                android:hint="Tìm kiếm sản phẩm, thương hiệu..."
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- ============================================================== -->
        <!-- 3. FrameLayout (Banner khuyến mãi):                            -->
        <!--    Ảnh banner làm nền, đè lên trên là TextView "Siêu Sale 11/11"-->
        <!-- ============================================================== -->
        <FrameLayout
            android:id="@+id/layoutBanner"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="14dp">

            <!-- Ảnh banner làm nền -->
            <ImageView
                android:id="@+id/imgBannerBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EA580C"
                android:scaleType="centerCrop"
                android:contentDescription="Banner nền" />

            <!-- Lớp nội dung xếp đè lên trên (FrameLayout stack) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FEF08A"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="ĐẠI TIỆC MUA SẮM"
                    android:textColor="#854D0E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Dòng chữ chính "Siêu Sale 11/11" đè lên banner -->
                <TextView
                    android:id="@+id/tvBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SIÊU SALE 11/11"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Giảm sốc tới 50% • Freeship 0Đ toàn quốc"
                    android:textColor="#FED7AA"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============================================================== -->
        <!-- 4. LinearLayout (Thanh danh mục): Xếp ngang các nút danh mục    -->
        <!-- ============================================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCatPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/primary_indigo"
                    android:text="Điện thoại"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatLaptop"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:text="Laptop"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatAccessory"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:text="Phụ kiện"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatTablet"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/white"
                    android:text="Tablet"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatWatch"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/white"
                    android:text="Đồng hồ"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================== -->
        <!-- 5. AbsoluteLayout (Các icon tiện ích nhỏ):                      -->
        <!--    Đặt icon "Mã giảm giá", "Freeship"... ở tọa độ X, Y cố định -->
        <!-- ============================================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiện ích nhanh (AbsoluteLayout):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <AbsoluteLayout
            android:id="@+id/layoutUtilities"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:background="@color/white">

            <!-- Icon 1: Tọa độ x=10dp, y=8dp -->
            <TextView
                android:id="@+id/utilCoupon"
                android:layout_width="100dp"
                android:layout_height="46dp"
                android:layout_x="10dp"
                android:layout_y="8dp"
                android:background="#FEF3C7"
                android:gravity="center"
                android:padding="4dp"
                android:text="🎟 Mã giảm giá\nGiảm 50k"
                android:textColor="#92400E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Icon 2: Tọa độ x=125dp, y=8dp -->
            <TextView
                android:id="@+id/utilFreeship"
                android:layout_width="100dp"
                android:layout_height="46dp"
                android:layout_x="125dp"
                android:layout_y="8dp"
                android:background="#DCFCE7"
                android:gravity="center"
                android:padding="4dp"
                android:text="🚚 Freeship\nĐơn từ 0Đ"
                android:textColor="#166534"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Icon 3: Tọa độ x=240dp, y=8dp -->
            <TextView
                android:id="@+id/utilCoins"
                android:layout_width="100dp"
                android:layout_height="46dp"
                android:layout_x="240dp"
                android:layout_y="8dp"
                android:background="#FEE2E2"
                android:gravity="center"
                android:padding="4dp"
                android:text="🪙 Xu thưởng\n+10.000 Xu"
                android:textColor="#991B1B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </AbsoluteLayout>

        <!-- ============================================================== -->
        <!-- 6. TableLayout (Bảng giá / Bộ lọc):                            -->
        <!--    Hiển thị "Khoảng giá" và "Sắp xếp theo" bằng <TableRow>      -->
        <!-- ============================================================== -->
        <TableLayout
            android:id="@+id/tableFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="10dp"
            android:stretchColumns="1,2,3">

            <!-- Hàng 1: Khoảng giá -->
            <TableRow android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="Khoảng giá:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F1F5F9"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="&lt; 5 triệu"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:background="#EEF2FF"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="5 - 15 triệu"
                    android:textColor="@color/primary_indigo"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F1F5F9"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="&gt; 15 triệu"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </TableRow>

            <!-- Hàng 2: Sắp xếp theo -->
            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="Sắp xếp theo:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EEF2FF"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Phổ biến"
                    android:textColor="@color/primary_indigo"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F1F5F9"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Giá tăng"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F1F5F9"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Giá giảm"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </TableRow>
        </TableLayout>

        <!-- Tiêu đề khu vực sản phẩm -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Gợi Ý Hôm Nay (GridView 2 cột):"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ============================================================== -->
        <!-- 7. GridView (Hiển thị sản phẩm 2 cột)                          -->
        <!-- ============================================================== -->
        <GridView
            android:id="@+id/gridViewProducts"
            android:layout_width="match_parent"
            android:layout_height="560dp"
            android:numColumns="2"
            android:verticalSpacing="8dp"
            android:horizontalSpacing="8dp"
            android:stretchMode="columnWidth"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />

    </LinearLayout>
</ScrollView>
